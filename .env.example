# Optional overrides:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Examples:
# OpenAI:     AI_API_KEY=sk-...   AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# Groq:       AI_API_KEY=gsk_... AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# OpenRouter: AI_API_KEY=...     AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=openai/gpt-4o-mini
